# Runtime state — must never be versioned
scripts/statusline/data/
scripts/*/data/last_*
**/.claude/run/
**/.claude/settings.local.json
**/.claude/worktrees/
**/.turnlock/

# Dependencies + build artefacts
node_modules/
__pycache__/
*.pyc
bun.lockb
package-lock.json
.index-state.json

# Logs
*.log

# OS
.DS_Store

# Sub-agent artefacts (pi, codex)
.pi-subagents/

# Local agent working dirs (safe to ignore)
.claude/plans/
.claude/sessions/

# ── Claude Code facade (generated by ~/.agents/scripts/claude-facade) ──
